# Read Access Token do TMDB (Configurações da conta > API > API Read Access Token)
TMDB_READ_TOKEN=

# Opcional. Sem esta variável, o cliente já usa a API real do TMDB por padrão.
# Só existe para apontar para uma API falsa (ex.: em `npm run test:e2e`, que a
# define sozinho para http://127.0.0.1:4010 — não precisa mexer aqui para isso).
# TMDB_BASE_URL=https://api.themoviedb.org/3
